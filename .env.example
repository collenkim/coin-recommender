# .env.example — 복사해서 .env로 저장 후 값 채우기. .env는 절대 커밋하지 마세요.

# Telegram: 봇 토큰 + 채팅 ID (텔레그램은 Discord와 달리 단일 webhook URL이 없음 -- Bot API 사용)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: 웹훅 URL
DISCORD_WEBHOOK_URL=

# Slack: Incoming Webhook URL (https://hooks.slack.com/services/T.../B.../...)
# Slack 앱 > Incoming Webhooks 활성화 > Add New Webhook to Workspace 에서 채널을 고르면 발급됩니다.
SLACK_WEBHOOK_URL=

# 비워둔 채널로는 알림을 보내지 않습니다 (에러 아님). 설정된 채널에는 각각 독립적으로 발송하며,
# 한 채널이 실패해도 나머지 채널 발송은 계속됩니다.
